PORT=4000
NODE_ENV=development
APP_TIMEZONE=Asia/Jakarta

# Alamat frontend: dipakai untuk CORS dan link reset password di email
APP_URL=http://localhost:5173

# Harus sama dengan docker-compose.yml
DATABASE_URL=postgres://mutabaah:mutabaah@localhost:5432/mutabaahku
# Database terpisah untuk `npm test` (dibuat otomatis oleh test)
TEST_DATABASE_URL=postgres://mutabaah:mutabaah@localhost:5432/mutabaahku_test

# Ganti dengan string acak panjang, contoh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
RESET_TOKEN_TTL_MINUTES=60

# SMTP untuk email lupa password. Jika SMTP_HOST kosong, email hanya dicetak ke console.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_PASS = App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Mutaba'ahku <no-reply@mutabaahku.local>

# Password awal untuk akun hasil seed (wajib diganti saat login pertama)
SEED_DEFAULT_PASSWORD=bismillah123
