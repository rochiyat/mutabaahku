# Salin ke .env.production lalu isi. File .env.production jangan di-commit.

# Alamat publik aplikasi (HTTPS). Dipakai untuk link di email.
APP_URL=https://mutabaah.contoh.com

# Port di host yang diteruskan reverse proxy. Default hanya bisa diakses dari mesin itu sendiri.
APP_PORT=8080
APP_BIND=127.0.0.1

POSTGRES_USER=mutabaah
POSTGRES_DB=mutabaahku
# String acak panjang, contoh: openssl rand -hex 24
POSTGRES_PASSWORD=

# String acak minimal 32 karakter, contoh: openssl rand -hex 48
JWT_SECRET=

# Email undangan & reset password. Gmail: smtp.gmail.com, 465, true, App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Mutaba'ahku <email-pengirim@contoh.com>
